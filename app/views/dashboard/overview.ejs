<%- include('../partials/header-dash') %> <!-- Inclut le header global depuis un fichier partiel -->

<main class="dashboard-container" aria-labelledby="dashboard-title">
  <!-- Section principale de l'application tableau de bord -->
  
  <!-- Barre latérale : menu de navigation -->
  <aside class="overview-dashboard-sidebar" role="navigation" aria-label="Menu principal">
    <nav class="overview-sidebar-menu">
      <a href="/dashboard/overview" class="overview-sidebar-link">Compte</a>
      <a href="/dashboard/income" class="overview-sidebar-link">Analyse</a>
      <a href="/profile/profile" class="overview-sidebar-link">Profil</a>
    </nav>
    <a href="/" class="overview-sidebar-link overview-logout">Déconnexion</a>
  </aside>

  <!-- Cercle de progression -->
  <div class="progress-circle" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
