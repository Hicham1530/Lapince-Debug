<%- include('../partials/header-dash') %>

<main class="dashboard-container" aria-labelledby="dashboard-title">

  <!-- Conteneur principal -->
  <div class="centered-container">

    <!-- Titre principal -->
    <h1 class="titre-incomes">Gestion des revenus</h1>
  
   <!-- Formulaire pour ajouter un revenu -->
   <section class="income-form">
    <h3> ajoutez un revenu :</h3> <!-- Ajout du titre -->
    
    <form id="income-form" action="/dashboard/incomes/add" method="POST">
      
      <!-- Ligne 1 : Catégorie - Date -->
      <div class="form-row">
        <div class="form-group">
          <label for="selected-category">Catégorie :</label>
          <select name="category" id="selected-category" required>
            <option value="" disabled selected>-- Sélectionnez une catégorie --</option>
            <% categories.forEach(category => { %>
              <option value="<%= category %>"><%= category %></option>
            <% }); %>
          </select>
        </div>
  
        <div class="form-group">
          <label for="selected-date">Date :</label>
          <input type="date" name="date" id="selected-date" required /> 
        </div>
      </div>
  
      <!-- Ligne 2 : Description - Montant (€) -->
      <div class="form-row">
        <div class="form-group">
          <label for="description">Description :</label>
          <input type="text" name="description" id="description" />
        </div>
  
        <div class="form-group">
          <label for="amount">Montant (€) :</label>
          <input type="number" name="amount" id="amount" min="0" step="0.01" required />
        </div>
      </div>
  
      <!-- Bouton Enregistrer -->
      <button type="submit">Enregistrer</button>
    </form>
  </section>
<!-- Bloc Historique des Transactions -->
<section class="income-operations">
  <div class="transaction-container">
    <h2 id="total-incomes">Historique des transactions & Total des revenus : € <%= totalRevenus.toFixed(2) %></h2>
    <div id="income-list" class="transaction-list">
      <!-- Les transactions passées seront affichées ici -->
    </div>
  </div>
</section>
  </div>
</main>

<%- include('../partials/footer') %>

<script>
  // Interaction pour sélectionner une catégorie
  document.querySelectorAll('.category-button').forEach(button => {
  button.addEventListener('click', () => {
    console.log("Début de l'événement click");
    
    const selectedCategory = button.textContent;
    document.getElementById('selected-category').value = selectedCategory;

    console.log("Catégorie choisie :", selectedCategory);
    console.log("Fin de l'événement click");
  });
});


// Récupérer les éléments nécessaires
const form = document.getElementById("income-form");
const operationsList = document.getElementById("income-list");
const totalElement = document.getElementById("total-incomes"); // Identifier correct pour les revenus

/**
/**
 * Met à jour le total des montants affichés dans la liste des opérations.
 * @param {string} type - Le type d'opérations, soit 'incomes' (revenus).
 */
 function updateTotal() {
  // Récupérer les éléments du total des revenus et du solde total
  const totalIncomesElement = document.getElementById("total-incomes");
  const totalBalanceElement = document.getElementById("balance-value"); // Solde total en haut de la page

  if (totalIncomesElement && totalBalanceElement) {
    const totalIncomesText = totalIncomesElement.textContent;
    const totalMatch = totalIncomesText.match(/[\d,.]+/); // Extraire le nombre du texte

    if (totalMatch) {
      const newTotalRevenues = parseFloat(totalMatch[0].replace(",", ".")); // Convertir en nombre

      // Récupérer les dépenses totales affichées
      const totalExpensesElement = document.getElementById("total-expenses");
      let totalExpenses = 0;
      if (totalExpensesElement) {
        const totalExpensesText = totalExpensesElement.textContent.match(/[\d,.]+/);
        totalExpenses = totalExpensesText ? parseFloat(totalExpensesText[0].replace(",", ".")) : 0;
      }

      // Calculer et mettre à jour le solde total
      const calculatedBalance = newTotalRevenues - (isNaN(totalExpenses) ? 0 : totalExpenses);
      totalBalanceElement.textContent = `${calculatedBalance.toFixed(2)}€`;

      // Mettre à jour l'affichage du total des revenus
      totalIncomesElement.textContent = `Total des revenus : € ${newTotalRevenues.toFixed(2)}`;
    }
  }
}


/**
 * Ajoute une nouvelle opération à la liste.
 * @param {string} category - La catégorie de l'opération.
 * @param {string} date - La date de l'opération.
 * @param {string} description - La description de l'opération.
 * @param {number|string} amount - Le montant de l'opération.
 */
 function addOperation(category, date, description, amount) {
  const operationItem = document.createElement("div");
  operationItem.classList.add("operation-item");

  operationItem.innerHTML = `
  <table class="operation-table">
    <tr>
      <td><strong>Revenu :</strong> ${amount}€</td>
      <td>${category}</td>
      <td>${description}</td>
      <td>${date}</td>
      <td class="delete-cell">
        <button class="delete-button">
          <img src="/image/poubelle.png" alt="Supprimer" />
        </button>
      </td>
    </tr>
  </table>
`;
 
  // Ajouter l'opération à la liste
  operationsList.appendChild(operationItem);

  // Mettre à jour le total affiché
  const totalElement = document.getElementById("total-incomes");
  if (totalElement) {
    let currentTotal = parseFloat(totalElement.textContent.match(/[\d,.]+/)[0].replace(",", ".")) || 0;
    currentTotal += parseFloat(amount);
    totalElement.textContent = `Total des revenus : € ${currentTotal.toFixed(2)}`;
  }

// Ajouter un événement de suppression
operationItem.querySelector(".delete-button").addEventListener("click", function () {
  const amountToRemove = parseFloat(amount); // Récupérer le montant à soustraire
  operationItem.remove(); // Supprimer l'élément du DOM

  // Mettre à jour le total des revenus
  const totalIncomesElement = document.getElementById("total-incomes");
  let currentTotal = 0;
  if (totalIncomesElement) {
    let match = totalIncomesElement.textContent.match(/[\d,.]+/);
    currentTotal = match ? parseFloat(match[0].replace(",", ".")) : 0;
    currentTotal -= amountToRemove; // Soustraire le montant supprimé
    totalIncomesElement.textContent = `Total des revenus : € ${currentTotal.toFixed(2)}`;
  }

  // Mettre à jour le solde total affiché en haut de la page
  const totalBalanceElement = document.getElementById("balance-value");
  if (totalBalanceElement) {
    // Récupérer les dépenses totales
    const totalExpensesElement = document.getElementById("total-expenses");
    let totalExpenses = 0;
    if (totalExpensesElement) {
      let matchExpenses = totalExpensesElement.textContent.match(/[\d,.]+/);
      totalExpenses = matchExpenses ? parseFloat(matchExpenses[0].replace(",", ".")) : 0;
    }

    // Calculer le nouveau solde total après suppression du revenu
    const newBalance = currentTotal - totalExpenses;
    totalBalanceElement.textContent = `${newBalance.toFixed(2)}€`;
  }
});



}


// Gestion de l'événement de soumission du formulaire
form.addEventListener("submit", function (e) {
  e.preventDefault(); // Empêche le rechargement de la page

  const category = document.getElementById("selected-category").value.trim();
  const date = document.getElementById("selected-date").value.trim();
  const description = document.getElementById("description").value.trim();
  const amount = document.getElementById("amount").value.trim();

  // LOG : Afficher les données récupérées
  console.log("Données du formulaire avant envoi :", { category, date, description, amount });

  if (!category || !date || !description || !amount) {
    alert("Veuillez remplir tous les champs !");
    return;
  }

  // Créer l'objet à envoyer
  const data = { category, date, description, amount };

  // Envoyer les données au backend via fetch
  fetch("/dashboard/incomes/add", {
  method: "POST",
  headers: { "Content-Type": "application/json" },
  body: JSON.stringify(data),
})
.then((response) => {
  console.log("Réponse brute :", response);
  return response.json();
})
.then((data) => {
  console.log("Réponse JSON :", data);
  if (data.success) {
    alert("Revenu ajouté avec succès !");
    console.log("Ajout à l'interface :", category, date, description, amount);
    addOperation(category, date, description, amount); // Ajouter à l'interface
    updateTotal(); // Mettre à jour le total des revenus !
  } else {
    alert("Erreur lors de l'ajout du revenu.");
  }
})
    .catch((error) => {
      console.error("Erreur lors de la requête :", error);
    });
});
</script>
