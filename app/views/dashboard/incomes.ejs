<%- include('../partials/header-profiles') %>

<main class="dashboard-container" aria-labelledby="dashboard-title">

  <!-- Conteneur principal centré -->
  <div class="centered-container">
    <section class="income-form">

      <!-- Titre de la page -->
      <h1 class="titre-incomes">Gestion des transactions</h1>

      <!-- Résumé des totaux (revenus, dépenses, solde) -->
      <section class="summary">
        <div class="summary-item">
          <h2>Total des revenus</h2>
          <p id="summary-income">€ <%= totalRevenus.toFixed(2) %></p>
        </div>
        <div class="summary-item">
          <h2>Total des dépenses</h2>
          <p id="summary-expenses">€ <%= totalDepenses.toFixed(2) %></p>
        </div>
        <div class="summary-item">
          <h2>Solde net</h2>
          <p id="summary-balance">€ <%= soldeTotal.toFixed(2) %></p>
        </div>
        <% if (user.convertir_montants && user.currency !== 'eur') { %>
          <div class="summary-item">
            <h2>Solde net en <%= userCurrency %></h2>
            <p id="summary-balance-converted">
              <%= userCurrency %> <%= (soldeTotal * conversionRate).toFixed(2) %>
            </p>
          </div>
        <% } %>
      </section>

      <!-- Bloc pour choisir le type de transaction -->
         <!-- Bloc pour choisir le type de transaction -->
         <div class="type-selector-inline">
          <span class="transaction-label">Ajoutez une transaction :</span>
          <span class="type-label">type :</span>
        
          <label class="radio-option">
            <input type="radio" name="type" value="revenu" checked> Revenu
          </label>
        
          <label class="radio-option">
            <input type="radio" name="type" value="depense"> Dépense
          </label>
        </div>
        

      <!-- Formulaire pour saisir une transaction -->
      <form id="income-form" action="/dashboard/incomes/add" method="POST">

        <!-- Ligne 1 : Choix de la catégorie et date -->
        <div class="form-row inputs-row">
          <div class="form-group">
            <label for="selected-category">Catégorie :</label>
            <select id="selected-category" name="category" required
              data-categories-revenu='<%= JSON.stringify(categoriesRevenu) %>'
              data-categories-depense='<%= JSON.stringify(categoriesDepense) %>'>
              <option value="" disabled selected>-- Sélectionnez une catégorie --</option>
            </select>
          </div>
          <div class="form-group">
            <label for="selected-date">Date :</label>
            <input type="date" name="date" id="selected-date" required />
          </div>
          <div class="form-group">
            <label for="description">Description :</label>
            <input type="text" name="description" id="description" />
          </div>
          <div class="form-group">
            <label for="amount">Montant (€) :</label>
            <input type="number" name="amount" id="amount" min="0" step="0.01" required />
          </div>
        </div>
        <!-- Ligne 3 : Bouton d'ajout -->
        <div class="button-container">
          <button type="submit">Enregistrer</button>
        </div>

      </form>
    
      <!-- Liste des transactions précédemment ajoutées -->
      <section class="income-operations">
        <h2 class="transactions-title">Historique des transactions : </h2>
        <div class="transaction-container">
          <div id="income-list" class="transaction-list">
            <!-- Les transactions seront insérées ici dynamiquement -->
          </div>
        </div>
      </section>
      

    </section>
  </div>
</main>

<%- include('../partials/footer') %>

<!-- Script JavaScript pour gérer le formulaire, les catégories et les transactions -->
<script>

  // Attente du chargement de la page
  document.addEventListener('DOMContentLoaded', () => {
    const selectCategory = document.getElementById('selected-category');
    const categoriesRevenu = JSON.parse(selectCategory.dataset.categoriesRevenu);
    const categoriesDepense = JSON.parse(selectCategory.dataset.categoriesDepense);
    const typeRadios = Array.from(document.getElementsByName('type'));

    // Met à jour les catégories selon le type sélectionné
    function updateCategories() {
      const selectedType = document.querySelector('input[name="type"]:checked').value;
      const list = selectedType === 'revenu' ? categoriesRevenu : categoriesDepense;
      selectCategory.innerHTML = '<option value="" disabled selected>-- Sélectionnez une catégorie --</option>';
      list.forEach(cat => {
        const opt = document.createElement('option');
        opt.value = cat;
        opt.textContent = cat;
        selectCategory.appendChild(opt);
      });
    }

    // Écoute du changement de type (radio bouton)
    typeRadios.forEach(radio => radio.addEventListener('change', updateCategories));
    updateCategories();
  });

  // Sélection rapide de catégorie via bouton externe
  document.querySelectorAll('.category-button').forEach(button => {
    button.addEventListener('click', () => {
      const selectedCategory = button.textContent;
      document.getElementById('selected-category').value = selectedCategory;
    });
  });

  // Variables de base pour manipuler le formulaire et les totaux
  const form = document.getElementById("income-form");
  const operationsList = document.getElementById("income-list");
  const totalElement = document.getElementById("total-incomes");

  // Met à jour les totaux affichés (revenus, dépenses, solde)
  function updateTotal(type, amount) {
  const totalIncomesEl  = document.getElementById("summary-income");
  const totalExpensesEl = document.getElementById("summary-expenses");

  let currentIn = parseFloat(totalIncomesEl.textContent.match(/[\d.]+/)[0]) || 0;
  let currentEx = parseFloat(totalExpensesEl.textContent.match(/[\d.]+/)[0]) || 0;

  if (type === 'depense') {
    currentEx += parseFloat(amount);
    totalExpensesEl.textContent = `€ ${currentEx.toFixed(2)}`;
  } else {
    currentIn += parseFloat(amount);
    totalIncomesEl.textContent  = `€ ${currentIn.toFixed(2)}`;
  }

  const newBalance = currentIn - currentEx;

  //  Mettre à jour le solde affiché dans le résumé
  document.getElementById("summary-balance").textContent = `€ ${newBalance.toFixed(2)}`;

  //  **NOUVEAU** : mettre à jour aussi le Solde Total du header
  const headerBalanceEl = document.getElementById("balance-value");
if (headerBalanceEl) {
  headerBalanceEl.textContent = `€ ${newBalance.toFixed(2)}`;
}
}


  // Ajoute une transaction dans la liste affichée
  function addOperation(category, date, description, amount, type) {
  const operationItem = document.createElement("div");
  operationItem.classList.add("operation-item");

  operationItem.dataset.type = type;  
  const label = type === 'depense' ? 'Dépense' : 'Revenu';
  const colorClass = type === 'depense' ? 'expense-color' : 'income-color';
  
  operationItem.innerHTML = `
    <table class="operation-table">
      <tr>
        <td class="${colorClass}"><strong>${label} :</strong> ${amount}€</td>
        <td>${category}</td>
        <td>${description}</td>
        <td>${date}</td>
        <td class="delete-cell">
          <button class="delete-button" type="button">
            <img src="/image/poubelle.png" alt="Supprimer" />
          </button>
        </td>
      </tr>
    </table>
  `;

  operationsList.appendChild(operationItem);
  
  // Faire défiler automatiquement vers le bas après ajout
  const container = document.querySelector('.transaction-container');
  if (container) {
    container.scrollTop = container.scrollHeight;
  }

    // Met à jour le total revenus
    const totalElement = document.getElementById("total-incomes");
    if (totalElement) {
      let currentTotal = parseFloat(totalElement.textContent.match(/[\d,.]+/)[0].replace(",", ".")) || 0;
      currentTotal += parseFloat(amount);
      totalElement.textContent = `Total des revenus : € ${currentTotal.toFixed(2)}`;
    }

    // Supprimer une transaction
    operationItem.querySelector(".delete-button").addEventListener("click", async () => {
  const amountToRemove = parseFloat(amount);
  const opType = operationItem.dataset.type; // 'revenu' ou 'depense'
  // Choisissez la bonne route selon le type
  const url = opType === 'depense'
    ? '/dashboard/expenses/delete'
    : '/dashboard/incomes/delete';

  // Appel au backend pour supprimer en base
  const res = await fetch(url, {
    method: 'POST', // ou DELETE selon votre implémentation
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ category, date, description, amount })
  });
  const result = await res.json();
  if (!result.success) {
    return alert("Erreur lors de la suppression.");
  }

  // Retire la ligne du DOM
  operationItem.remove();

  // Recalcule immédiatement les totaux du résumé
  const incEl = document.getElementById("summary-income");
  const expEl = document.getElementById("summary-expenses");
  let currInc = parseFloat(incEl.textContent.match(/[\d.]+/)[0]);
  let currExp = parseFloat(expEl.textContent.match(/[\d.]+/)[0]);
  if (opType === 'depense') {
    currExp -= amountToRemove;
    expEl.textContent = `€ ${currExp.toFixed(2)}`;
  } else {
    currInc -= amountToRemove;
    incEl.textContent = `€ ${currInc.toFixed(2)}`;
  }
  // Et le solde dans le résumé
  document.getElementById("summary-balance").textContent = 
    `€ ${(currInc - currExp).toFixed(2)}`;

  // **ENFIN**, on met à jour le solde du header
  document.getElementById("balance-value").textContent =
    `${(currInc - currExp).toFixed(2)}€`;
});

  }

  // Gestion de l'envoi du formulaire (AJAX)
  form.addEventListener("submit", function (e) {
    e.preventDefault();

    const category = document.getElementById("selected-category").value.trim();
    const date = document.getElementById("selected-date").value.trim();
    const description = document.getElementById("description").value.trim();
    const amount = document.getElementById("amount").value.trim();
    const type = document.querySelector('input[name="type"]:checked').value;

    if (!category || !date || !description || !amount) {
      alert("Veuillez remplir tous les champs !");
      return;
    }

    const data = { category, date, description, amount };
    const url = type === 'depense' ? '/dashboard/expenses/add' : '/dashboard/incomes/add';

    fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ category, date, description, amount })
    })
    .then((response) => response.json())
    .then(data => {
      if (data.success) {
        const alertMsg = type === 'depense'
          ? "Dépense ajoutée avec succès !"
          : "Revenu ajouté avec succès !";
        alert(alertMsg);
        addOperation(category, date, description, amount, type);
        updateTotal(type, parseFloat(amount));
      } else {
        alert("Erreur lors de l'ajout de la transaction.");
      }
    })
    .catch((error) => {
      console.error("Erreur lors de la requête :", error);
    });
  });
</script>