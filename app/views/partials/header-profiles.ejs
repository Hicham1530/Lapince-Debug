<!DOCTYPE html> <!-- Indique que le document est en HTML5 -->
<html lang="fr"> <!-- Définit la langue principale du document comme le français -->
<head>
    <meta charset="UTF-8"> <!-- Définit l'encodage des caractères en UTF-8 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Configure la page pour être responsive sur les appareils mobiles -->
    <meta name="description" content="La Pince - Simplifiez vos finances grâce à nos solutions innovantes."> <!-- Description pour le référencement SEO -->
    <meta name="keywords" content="finances, budget, gestion, La Pince, simplification, économie"> <!-- Mots-clés pour le SEO -->
    <meta name="author" content="La Pince"> <!-- Mentionne l'auteur de la page -->
    <link rel="stylesheet" href="/css/style.css"> <!-- Lien vers la feuille de style principale -->
    <link rel="stylesheet" href="/css/login.css"> <!-- Lien vers la feuille de style spécifique à la page de connexion -->
    <link rel="stylesheet" href="/css/reset.css"> <!-- Lien vers la feuille de style pour réinitialiser les styles par défaut des navigateurs -->
    <link rel="stylesheet" href="/css/signup.css"> <!-- Lien vers la feuille de style spécifique à la page d'inscription -->
    <link rel="stylesheet" href="/css/overview.css"> <!-- Lien vers la feuille de style pour la page du tableau de bord -->
    <link rel="stylesheet" href="/css/reset-password.css"> <!-- Lien vers la feuille de style pour la page de réinitialisation du mot de passe -->
    <link rel="stylesheet" href="/css/incomes.css"> <!-- Lien vers la feuille de style spécifique à la page des declaration -->
    <!--<link rel="stylesheet" href="/css/expenses.css">  Lien vers la feuille de style spécifique à la page des dépenses -->
    <link rel="stylesheet" href="/css/settings-header.css"><!--  Lien vers la feuille de style spécifique à la page settings -->
    <link rel="stylesheet" href="/css/profile.css"> <!-- Lien vers la feuille de style spécifique à la page profile -->
     <link rel="stylesheet" href="/css/settings.css"><!--  Lien vers la feuille de style spécifique à la page parametre -->
    <link rel="stylesheet" href="/css/email.css"> <!-- Lien vers la feuille de style spécifique à la page email -->
    <link rel="stylesheet" href="/css/password.css"> <!-- Lien vers la feuille de style spécifique à la page password -->
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon"> <!-- Définit l'icône affichée dans l'onglet du navigateur -->
    <link href="https://fonts.googleapis.com/css?family=Roboto&display=swap" rel="stylesheet"> <!-- Lien vers la police Roboto via Google Fonts -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.css"> <!-- Lien vers la bibliothèque d'icônes FontAwesome -->
    <title>La Pince - Maîtrisez vos finances</title> <!-- Définit le titre de la page, visible dans l'onglet du navigateur -->
</head>
<body>
    <!-- En-tête contenant la navigation principale -->
    <header>
        <!-- Barre de navigation -->
        <nav>
            <div class="left-section">
                <!-- Logo avec un lien vers la page d'accueil -->
                <a href="/" aria-label="Retour à l'accueil">
                    <img src="/image/logo_with_transparent_background.png" alt="Logo de La Pince" class="logo">
                </a>
                <button id="toggle-theme" class="theme-toggle-btn" aria-label="Changer de thème">
                    <span id="icon-theme">🌜</span> <!-- ← ce span doit exister -->
                  </button>
                <!-- Informations sur le profil utilisateur -->
                <div class="profile-container">
                    <div class="profile-balance">
                        <% if (user) { %>
                            <p><%= user.first_name %> <%= user.last_name %></p>
                        <% } else { %>
                            <p>Utilisateur inconnu</p>
                        <% } %>
                    </div>
                    <div class="total-balance" id="total-balance-header">
                        Solde Total : <strong id="balance-value">€ <%= soldeTotal.toFixed(2) %></strong>
                    </div>
                </div>
                
                </div> 

            <!-- Menu burger -->
            <div class="burger-menu" onclick="toggleMenu()" aria-label="Ouvrir le menu de navigation">
                ☰
            </div>

            <div class="top-nav-links">
                <!-- <a href="/dashboard/overview" class="sidebar-link">Compte</a> -->
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Compte</button>
                    <div class="dropdown-menu" style="display: none;">
                        <a href="/dashboard/overview" class="dropdown-item">Situation</a>
                    </div>
                </div>
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Analyse</button>
                    <div class="dropdown-menu" style="display: none;">
                        <a href="/dashboard/incomes" class="dropdown-item">Revenus</a>
                        <a href="/dashboard/expenses" class="dropdown-item">Dépenses</a>
                    </div>
                </div>
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Profil</button>
                    <div class="dropdown-menu" style="display: none;">
                        <a href="/profile/profile" class="dropdown-item">Profile</a>
                        <a href="/profile/settings" class="dropdown-item">Paramètre</a>
                        <a href="/profile/password" class="dropdown-item">Mot de passe</a>
                        <a href="/profile/email" class="dropdown-item">Email</a>
                    </div>
                </div>
                <a href="/" class="sidebar-link logout">Déconnexion</a>
            </div>
        </nav>
       
    </header>

    <script src="/js/menu.js" defer></script>
    <script>
        // Fonction de gestion des menus déroulants
        document.addEventListener("DOMContentLoaded", () => {
            const dropdownButtons = document.querySelectorAll(".dropdown-btn");

            dropdownButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const menu = btn.nextElementSibling;

                    // Ferme tous les autres menus
                    document.querySelectorAll(".dropdown-menu").forEach(m => {
                        if (m !== menu) m.style.display = "none";
                    });

                    // Alterne l'affichage du menu cliqué
                    menu.style.display = (menu.style.display === "block") ? "none" : "block";
                });
            });

            // Ferme les menus si on clique ailleurs
            document.addEventListener("click", (e) => {
                if (!e.target.closest(".dropdown")) {
                    document.querySelectorAll(".dropdown-menu").forEach(m => m.style.display = "none");
                }
            });
        });
    </script>
</body>
</html>