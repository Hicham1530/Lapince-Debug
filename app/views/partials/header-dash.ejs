<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="La Pince - Simplifiez vos finances grâce à nos solutions innovantes.">
    <meta name="keywords" content="finances, budget, gestion, La Pince, simplification, économie">
    <meta name="author" content="La Pince">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/signup.css">
    <link rel="stylesheet" href="/css/overview.css">
    <link rel="stylesheet" href="/css/reset-password.css">
    <link rel="stylesheet" href="/css/incomes.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="shortcut icon" href="image/logo_with_transparent_background.png" type="image/x-icon"> <!-- Définit l'icône affichée dans l'onglet du navigateur -->
    <link href="https://fonts.googleapis.com/css?family=Roboto&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.13.0/css/all.css">
    <title>La Pince - Maîtrisez vos finances</title>
</head>
<body>
    <!-- En-tête de la page -->
    <header>
        <!-- Barre de navigation -->
        <nav>
            <div class="left-section">
                <!-- Logo avec un lien vers la page d'accueil -->
                <a href="index.html" aria-label="Retour à l'accueil">
                    <img src="/image/logo_with_transparent_background.png" alt="Logo de La Pince" class="logo">
                </a>
                <!-- Informations sur le profil utilisateur -->
                <div class="profile-container">
                    <div class="profile-balance">
                        <% if (user) { %>
                            <p><%= user.first_name %> <%= user.last_name %></p>
                        <% } else { %>
                            <p>Utilisateur inconnu</p>
                        <% } %>
                    </div>
<div class="total-balance" id="total-balance-header">Solde Total : <strong id="balance-value"> <%= typeof soldeTotal !== "undefined" ? soldeTotal : 0 %>€ </strong>
                    </div>
                </div>
            </div>

            <!-- Menu burger -->
            <div class="burger-menu" onclick="toggleMenu()" aria-label="Ouvrir le menu de navigation">
                ☰
            </div>

            <div class="top-nav-links">
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Compte</button>
                    <div class="dropdown-menu">
                        <a href="/dashboard/overview" class="dropdown-item">Situation</a>
                    </div>
                </div>
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Analyse</button>
                    <div class="dropdown-menu">
                        <a href="/dashboard/incomes" class="dropdown-item">Revenus</a>

                    </div>
                </div>
                <div class="dropdown top-dropdown">
                    <button class="dropdown-btn">Profil</button>
                    <div class="dropdown-menu">
                        <a href="/profile/profile" class="dropdown-item">Profile</a>
                        <a href="/profile/settings" class="dropdown-item">Paramètre</a>
                        <a href="/profile/password" class="dropdown-item">Mot de passe</a>
                        <a href="/profile/email" class="dropdown-item">Email</a>
                    </div>
                </div>
                <a href="/" class="sidebar-link logout">Déconnexion</a>
            </div>
        </nav>
    </header>

    <!-- Supprimé le référence à menu.js pour éviter les conflits potentiels -->
    <script>
        // Fonction pour le menu burger
        function toggleMenu() {
            const topNavLinks = document.querySelector('.top-nav-links');
            topNavLinks.classList.toggle('active');
        }

        // Fonction de gestion des menus déroulants
        document.addEventListener("DOMContentLoaded", function() {
            const dropdownButtons = document.querySelectorAll(".dropdown-btn");
            
            // Empêcher la propagation des clics sur les menus déroulants
            dropdownButtons.forEach(function(btn) {
                btn.addEventListener("click", function(e) {
                    e.stopPropagation(); // Important pour éviter les fermetures non désirées
                    const menu = this.nextElementSibling;
                    
                    // Ferme tous les autres menus
                    document.querySelectorAll(".dropdown-menu").forEach(function(m) {
                        if (m !== menu) m.style.display = "none";
                    });
                    
                    // Alterne l'affichage du menu cliqué
                    menu.style.display = (menu.style.display === "block") ? "none" : "block";
                });
            });
            
            // Ferme les menus si on clique ailleurs
            document.addEventListener("click", function() {
                document.querySelectorAll(".dropdown-menu").forEach(function(m) {
                    m.style.display = "none";
                });
            });
        });
    </script>
</body>
</html>