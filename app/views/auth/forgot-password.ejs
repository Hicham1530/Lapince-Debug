<%- include('../partials/header') %>

<main class="global-container">
  <section class="hero">
    <div class="reset-password-container box-border">
      <h2 class="reset-password-title">Réinitialisation du mot de passe</h2>
      <p class="reset-password-description">
        Entrez votre email pour recevoir un lien de réinitialisation.
      </p>

      <% if (errorMessage) { %>
        <div class="error-message flash-message">
          <p><%= errorMessage %></p>
        </div>
      <% } %>
      
      <% if (successMessage) { %>
        <div class="success-message flash-message">
          <p><%= successMessage %></p>
        </div>
      <% } %>
      <form action="/auth/forgot-password" method="POST">
        <label for="email">Email :</label>
        <input type="email" id="email" name="email" required />
        <button type="submit">Envoyer</button>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>

<script>
  setTimeout(() => {
    const messages = document.querySelectorAll('.error-message, .success-message');
    messages.forEach(message => message.remove());
  }, 2000); // Supprime après 1 secondes
</script>