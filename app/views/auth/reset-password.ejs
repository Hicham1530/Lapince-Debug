
<%- include('../partials/header') %> <!-- Inclut le fichier header -->

<main class="global-container">
  <section class="hero">
    <h1><%= title %></h1>
  <div class="reset-password-container box-border"> <!-- Ajout de la classe box-border -->
    <div class="reset-password-icon">
      <img src="/image/lock.png" alt="Icône clé" class="reset-password-key">
    </div>
    <h2 class="reset-password-title">Saisissez l'adresse email que vous avez utilisée pour vous enregistrer sur La Pince.</h2>
    <p class="reset-password-description">
      Vous recevrez un email contenant un lien pour réinitialiser votre mot de passe sur <span class="no-wrap">La Pince</span>.
    </p>

    <form class="reset-password-form" method="POST" action="/reset-password">
      <label for="email" class="reset-password-label">Votre adresse E-mail :</label>
      <input type="email" id="email" name="email" placeholder="John@doe.fr" class="reset-password-input" required>
      <button type="submit" class="reset-password-button">Réinitialiser votre mot de passe</button>
    </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>