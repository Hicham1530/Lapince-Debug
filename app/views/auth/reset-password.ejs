<%- include('../partials/header') %> <!-- Inclut le fichier header -->

<main class="global-container">
  <section class="hero">
    <h1><%= title %></h1>
    <div class="reset-password-container box-border"> <!-- Ajout de la classe box-border -->

      <h2 class="reset-password-title">Définir un nouveau mot de passe</h2>
      <p class="reset-password-description">
        Entrez un nouveau mot de passe sécurisé pour votre compte.
      </p>

      <% if (error) { %>
        <div class="error-message">
          <p><%= error %></p>
        </div>
      <% } %>

      <form class="reset-password-form" method="POST" action="/auth/reset-password/<%= token %>">
        <label for="password" class="reset-password-label">Nouveau mot de passe :</label>
        <input type="password" id="password" name="password" placeholder="Entrez un nouveau mot de passe" class="reset-password-input" required>

        <label for="confirmPassword" class="reset-password-label">Confirmez le mot de passe :</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirmez votre mot de passe" class="reset-password-input" required>

        <button type="submit" class="reset-password-button">Mettre à jour le mot de passe</button>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer -->