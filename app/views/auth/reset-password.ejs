<%- include('../partials/header') %> <!-- Inclut le fichier header -->

<main class="global-container">
  <section class="hero">

    <div class="reset-password-container box-border"> <!-- Ajout de la classe box-border -->

  <!-- Supprimer ou remplacez par un texte statique -->
<h2>Réinitialisation du mot de passe</h2>
      <p class="reset-password-description">
        Entrez un nouveau mot de passe sécurisé pour votre compte.
      </p>

      <% if (error) { %>
        <div class="error-message">
          <p><%= error %></p>
        </div>
      <% } %>
      <form  action="/auth/reset-password/<%= token %>" method="POST">
        <input type="password" name="password" placeholder="Nouveau mot de passe" autocomplete="email" required />
        <input type="password" name="confirmPassword" placeholder="Confirmez le mot de passe" autocomplete="email"required />
        <button type="submit">Réinitialiser</button> 
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer -->