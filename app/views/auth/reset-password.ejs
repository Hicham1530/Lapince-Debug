<%- include('../partials/header') %> <!-- Inclut le fichier header -->

<main class="global-container">
  <section class="hero">
    <div class="reset-password-container box-border">
      <h2 class="reset-password-title">Réinitialisation du mot de passe</h2>
      <p class="reset-password-description">Entrez un nouveau mot de passe sécurisé pour votre compte.</p>

      <!-- Affichage des erreurs -->
      <% if (errorMessage) { %>
        <div class="error-message">
          <p><%= errorMessage %></p>
        </div>
      <% } %>

      <!-- Affichage des messages de succès -->
      <% if (successMessage) { %>
        <div class="success-message">
          <p><%= successMessage %></p>
        </div>
      <% } %>

      <form action="/auth/reset-password/<%= token %>" method="POST">
        <input type="password" name="password" placeholder="Nouveau mot de passe" required />
        <input type="password" name="confirmPassword" placeholder="Confirmez le mot de passe" required />
        <button type="submit">Réinitialiser</button>
      </form>
    </div>
  </section>
</main>
<script>
  setTimeout(() => {
    const messages = document.querySelectorAll('.error-message, .success-message');
    messages.forEach(message => message.remove());
  }, 5000); // Supprime après 5 secondes
</script>
<%- include('../partials/footer') %> <!-- Inclut le fichier footer -->