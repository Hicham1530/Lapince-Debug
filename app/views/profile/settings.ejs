<%- include('../partials/header-profiles') %>
<main class="global-container">
  <section class="hero">
    <h1 class="title-settings">Modification des paramètres</h1>
<% if (successMessage) { %>
  <div class="alert alert-success"><%= successMessage %></div>
<% } %>
<!-- etc, pour chaque champ que tu veux traiter -->



    <div class="form-container4">
      <form action="/profile/settings" method="post">
        <!-- Langue de l'interface -->
        <div class="form-row">
          <label for="interface-langue">Langue de l'interface:</label>
          <select id="interface-langue" name="interface-langue">
            <option value="fr" <%= user.language === "fr" ? "selected" : "" %>>Français</option>
            <option value="en" <%= user.language === "en" ? "selected" : "" %>>English</option>
            <option value="es" <%= user.language === "es" ? "selected" : "" %>>Español</option>
          </select>
        </div>

        <!-- Devise par défaut -->
        <div class="form-row">
          <label for="devise">Devise :</label>
          <select id="devise" name="devise">
            <option value="usd" <%= user.currency === "usd" ? "selected" : "" %>>🇺🇸 Dollar américain (USD)</option>
            <option value="gbp" <%= user.currency === "gbp" ? "selected" : "" %>>🇬🇧 Livre sterling (GBP)</option>
            <option value="cad" <%= user.currency === "cad" ? "selected" : "" %>>🇨🇦 Dollar canadien (CAD)</option>
            <option value="try" <%= user.currency === "try" ? "selected" : "" %>>🇹🇷 Livre turque (TRY)</option>
            <option value="cny" <%= user.currency === "cny" ? "selected" : "" %>>🇨🇳 Yuan chinois (CNY)</option>
          </select>
        </div>

        <!-- Convertir tous les montants -->
        <div class="form-row">
          <label for="convert-montants">Conversion en devise :</label>
          <input
            type="checkbox"
            id="convert-montants"
            name="convertir_montants"
            <%= user.convertir_montants ? "checked" : "" %> />
        </div>

        <!-- Bouton de confirmation -->
        <div class="form-row-btn">
          <button type="submit" class="btn-confirmer">Confirmer</button>
        </div>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.querySelector(".alert-success");
    if (successMessage) {
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s";
        successMessage.style.opacity = "0";
        setTimeout(() => {
          successMessage.remove();
        }, 500); // Temps pour l’animation
      }, 1500); // Durée d’affichage avant disparition
    }
  });
</script>
