<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">


  <aside class="dashboard-sidebar" role="navigation" aria-label="Menu principal"> <!-- Barre latérale pour la navigation principale -->
    <nav class="sidebar-menu"> <!-- Menu contenant des liens vers différentes sections -->
      <a href="/dashboard/overview" class="sidebar-link">Compte</a> <!-- Lien pour accéder à la page "Compte" -->
      <a href="/dashboard/income" class="sidebar-link">Analyse</a><!-- Lien pour accéder à la page "Analyse" -->
      <a href="/profile/profile" class="sidebar-link">Profil</a><!-- Lien pour accéder à la page "Profil" --> </nav>
      <a href="/" class="sidebar-link logout">Déconnexion</a> <!-- Lien pour se déconnecter, probablement lié à une session utilisateur --> </aside>

<section class="hero">
  <h1>Modification des paramètres</h1>
  <div class="form-container">
    <form action="/settings" method="post">
      <div class="form-row">
        <label for="interface-langue">Langue de l'interface :</label>
        <select id="interface-langue" name="langue">
          <option value="fr">Français</option>
          <option value="en">English</option>
          <option value="es">Español</option>
        </select>
      </div>
  
      <div class="form-row">
        <label for="devise" class="adjust-label">Devise par défaut :</label>
        <select id="devise" name="devise">
          <option value="eur">Euro (€)</option>
          <option value="usd">Dollar ($)</option>
          <option value="mad">Dirham (MAD)</option>
        </select>
      </div>
  
      <div class="form-row">
        <label for="convert-montants">Convertir tous les montants :</label>
        <input type="checkbox" id="convert-montants" name="convertir_montants" />
      </div>
  
      <div class="form-row-btn">
        <button type="submit" class="btn-confirmer">Confirmer</button>
      </div>
    </form>
  </div>
</section>
</main>
<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->



