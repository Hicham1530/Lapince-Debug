<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">
<section class="hero">
  <h1>Modification des paramètres</h1>
  <% if (successMessage) { %>
    <div id="success-message" class="alert alert-success">
      <%= successMessage %>
    </div>
  <% } %> <!-- Affiche un message de succès si la variable successMessage est définie -->
  
  <div class="form-container2">
    <form action="/settings" method="post">
      <!-- Langue de l'interface -->
      <div class="form-row">
        <label for="interface-langue">Langue de l'interface:</label>
        <select id="interface-langue" name="interface-langue">
          <option value="fr" <%= user.language === "fr" ? "selected" : "" %>>Français</option>
          <option value="en" <%= user.language === "en" ? "selected" : "" %>>English</option>
          <option value="es" <%= user.language === "es" ? "selected" : "" %>>Español</option>
        </select>
      </div>
  
    <!-- Devise par défaut -->
    <div class="form-row">
      <label for="devise">Devise :</label>
      <select id="devise" name="devise">
        <option value="eur" <%= user.currency === "eur" ? "selected" : "" %>>Euro (€)</option>
        <option value="usd" <%= user.currency === "usd" ? "selected" : "" %>>Dollar ($)</option>
        <option value="mad" <%= user.currency === "mad" ? "selected" : "" %>>Dirham (MAD)</option>
      </select>
    </div>
  
  <!-- Convertir tous les montants -->
  <div class="form-row">
    <label for="convert-montants">Convertir tous les montants :</label>
    <input type="checkbox" id="convert-montants" name="convertir_montants" />
  </div>
  
    <!-- Bouton de confirmation -->
    <div class="form-row-btn">
      <button type="submit" class="btn-confirmer">Confirmer</button>
    </div>
  </form>
  </div>
</section>
</main>
<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->




<!-- faire disparaître le message de confirmation de changement d information profile  après 2 secondes -->
<script>
  // Attendre que la page soit chargée
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.querySelector(".alert.alert-success");

    if (successMessage) {
      // Faire disparaître le message après  secondes
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s ease";
        successMessage.style.opacity = "0";

        // Supprimer complètement le message après l'animation (2.5s)
        setTimeout(() => {
          successMessage.remove();
        }, 500);
      }, 700);
    }
  });
</script>