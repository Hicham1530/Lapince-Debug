<%- include('../partials/header-profiles') %>
<main class="global-container">
  <section class="hero">
    <h1 class="title-email">Modification de l'email</h1>

<% if (successMessage) { %>
  <div class="alert alert-success"><%= successMessage %></div>
<% } %>
<% if (errors && errors.email) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.email %>
  </div>
<% } %>
<% if (errors && errors.password) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.password %>
  </div>
<% } %>
<!-- etc, pour chaque champ que tu veux traiter -->


    <div class="form-container1">
      <form action="/profile/email" method="POST">
        <div class="form-row">
          <label for="new-email">Nouvel Email :</label>
          <input type="email" id="new-email" placeholder="Entrez votre email actuel" name="new_email" required/>
        </div>
        <div class="form-row">
          <label for="confirm-email">Confirmation Email :</label>
          <input type="email" id="confirm-email" placeholder="Entrez votre nouveau email" name="confirm_email" required/>
        </div>
        <div class="form-row">
          <label for="password">Mot de passe :</label>
          <input type="password" id="password" placeholder="xxxxxxxxx" name="password" required/>
        </div>
        <div class="form-button">
          <button type="submit">Confirmer</button>
        </div>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.querySelector(".alert-success");
    if (successMessage) {
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s";
        successMessage.style.opacity = "0";
        setTimeout(() => {
          successMessage.remove();
        }, 500);
      }, 1500);
    }
  });
</script>
