<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">
<section class="hero2">
  <h1>Modification du profil</h1>
<% if (successMessage) { %>
  <div class="alert alert-success"><%= successMessage %></div>
<% } %>
<% if (errors && errors.email) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.email %>
  </div>
<% } %>
<% if (errors && errors.password) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.password %>
  </div>
<% } %>
<!-- etc, pour chaque champ que tu veux traiter -->


  <div class="form-container-profile">
    <!-- Description pour les lecteurs d'écran -->
  
    <form action="/profile/update" method="POST" aria-labelledby="form-title" aria-describedby="form-description" novalidate>
    <fieldset>
        <legend id="form-title"></legend>

    <!-- Genre -->
<div class="form-row">
  <label for="genre">Genre :</label>
  <select id="genre" name="genre">
    <option value="" disabled>Choisissez...</option>
    <option value="Monsieur" <%= user.genre === 'Monsieur' ? 'selected' : '' %>>Monsieur</option>
    <option value="Madame" <%= user.genre === 'Madame' ? 'selected' : '' %>>Madame</option>
  </select>
  <% if (errors && errors.genre) { %>
    <div class="error-message"><%= errors.genre %></div>
  <% } %>
</div>

         <!-- Nom -->
<div class="form-row">
  <label for="nom">Nom :</label>
  <input type="text" id="nom" name="nom" value="<%= user.last_name || '' %>" placeholder="Votre nom">
  <% if (errors && errors.nom) { %>
   <div class="error-message"><%= errors.nom %></div>
  <% } %>
</div>

<!-- Prénom -->
<div class="form-row">
  <label for="prenom">Prénom :</label>
  <input type="text" id="prenom" name="prenom" value="<%= user.first_name || '' %>" placeholder="Votre prénom">
  <% if (errors && errors.prenom) { %>
   <div class="error-message"><%= errors.prenom %></div>
  <% } %>
</div>



<!-- Date de naissance -->
<div class="form-row">
  <label for="jour">Date de naissance :</label>
  <div class="date-group">
    <select id="jour" name="jour" aria-label="Jour" required>
      <option value="" disabled selected>Jour</option>
      <% for (let i = 1; i <= 31; i++) { %>
        <option value="<%= i %>" <%= user.date_of_birth && new Date(user.date_of_birth).getDate() === i ? 'selected' : '' %>><%= i %></option>
      <% } %>
    </select>
    <select id="mois" name="mois" aria-label="Mois" required>
      <option value="" disabled selected>Mois</option>
      <% const moisMapping = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"]; %>
      <% moisMapping.forEach((mois, index) => { %>
        <option value="<%= mois %>" <%= user.date_of_birth && new Date(user.date_of_birth).getMonth() === index ? 'selected' : '' %>><%= mois %></option>
      <% }) %>
    </select>
    <select id="annee" name="annee" aria-label="Année" required>
      <option value="" disabled selected>Année</option>
      <% for (let i = 1944; i <= 2006; i++) { %>
        <option value="<%= i %>" <%= user.date_of_birth && new Date(user.date_of_birth).getFullYear() === i ? 'selected' : '' %>><%= i %></option>
      <% } %>
    </select>
  </div>
</div>

        <!-- Pays -->
        <div class="form-row">
          <label for="pays">Pays :</label>
          <select id="pays" name="pays" required>
            <option value="" disabled>Choisissez...</option>
            <option value="France" <%= user.pays === 'France' ? 'selected' : '' %>>France</option>
            <option value="Belgique" <%= user.pays === 'Belgique' ? 'selected' : '' %>>Belgique</option>
            <option value="Suisse" <%= user.pays === 'Suisse' ? 'selected' : '' %>>Suisse</option>
          </select>
        </div>

        <!-- test pour langue et devise -->
        <!-- <div class="form-row">
          <label for="language">Langue :</label>
          <input type="text" id="language" name="language" value="" placeholder="Langue préférée" required>
        </div>
        
        <div class="form-row">
          <label for="currency">Devise :</label>
          <input type="text" id="currency" name="currency" value="" placeholder="Devise préférée" required>
        </div> -->

        <!-- Bouton -->
        <div class="form-button">
          <button type="submit" aria-label="Confirmer les modifications de profil">
            Confirmer les modifications
          </button>
        </div>
      </fieldset>
    </form>
  </div>
</section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.querySelector(".alert-success");
    if (successMessage) {
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s";
        successMessage.style.opacity = "0";
        setTimeout(() => {
          successMessage.remove();
        }, 500);
      }, 1500);
    }
  });
</script>

