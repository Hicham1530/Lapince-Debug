<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">
  <section class="hero">
    <h1>Modification du mot de passe</h1>
    
    <% if (successMessage) { %>
      <div id="success-message" class="alert alert-success">
        <%= successMessage %>
      </div>
    <% } %>

    <div class="form-container3" role="form" aria-labelledby="form-description">
      <form action="/update-password" method="POST">
        <!-- Champ caché obligatoire pour les gestionnaires de mots de passe -->
        <input
        type="text"
        name="username"
        id="username"
        value="<%= user.email %>"
        autocomplete="username"
        readonly
        tabindex="-1"
       />
        <!-- Description pour les lecteurs d'écran -->
        <p id="form-description" class="sr-only">
          Formulaire pour mettre à jour votre mot de passe.
        </p>
    
        <!-- Mot de passe actuel -->
        <div class="form-row">
          <label for="current-password">Mot de passe actuel :</label>
          <input
            type="password"
            id="current-password"
            name="current-password"
            placeholder="Entrez votre mot de passe actuel"
            aria-required="true"
            autocomplete="current-password"

            required
          />
        </div>
    
        <!-- Nouveau mot de passe -->
        <div class="form-row">
          <label for="new-password">Nouveau mot de passe :</label>
          <input
            type="password"
            id="new-password"
            name="new-password"
            placeholder="Entrez un nouveau mot de passe"
            aria-required="true"
            aria-describedby="password-requirements"
            minlength="12"
            autocomplete="new-password"
            required
          />
        </div>
    
        <!-- Confirmation du mot de passe -->
        <div class="form-row">
          <label for="confirm-password">Confirmation du mot de passe :</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            placeholder="Confirmez votre nouveau mot de passe"
            aria-required="true"
            autocomplete="new-password"
            required
          />
        </div>
    
        <!-- Message pour les lecteurs d'écran -->
        <p id="password-requirements" class="sr-only">
          Votre mot de passe doit contenir au moins 12 caractères.
        </p>
    
        <!-- Bouton de soumission -->
        <div class="form-button">
          <button type="submit" aria-label="Confirmer la mise à jour du mot de passe">
            Confirmer
          </button>
        </div>
      </form>
    </div>


  </section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->



<!-- faire disparaître le message de confirmation de changement d information profile  après 2 secondes -->
<script>
  // Attendre que la page soit chargée
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.querySelector(".alert.alert-success");

    if (successMessage) {
      // Faire disparaître le message après  secondes
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s ease";
        successMessage.style.opacity = "0";

        // Supprimer complètement le message après l'animation (2.5s)
        setTimeout(() => {
          successMessage.remove();
        }, 500);
      }, 700);
    }
  });
</script>