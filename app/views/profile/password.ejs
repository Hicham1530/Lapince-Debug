<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">
  <section class="hero">
    <h1 class="title-password">Modification du mot de passe</h1>
    <!-- <div class="alert alert-success">Test affichage message succès</div> -->
    <div class="form-container3" role="form" aria-labelledby="form-description">
      <form action="/update-password" method="POST">
    
<% if (successMessage) { %>
  <div id="success-message" class="alert alert-success"><%= successMessage %></div>
<% } %>
<% if (errors && errors.email) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.email %>
  </div>
<% } %>
<% if (errors && errors.password) { %>
  <div class="alert alert-danger" style="margin-bottom: 16px; color: red;">
    <%= errors.password %>
  </div>
<% } %>
<!-- etc, pour chaque champ que tu veux traiter -->




        <!-- Champ caché obligatoire pour les gestionnaires de mots de passe -->
        <input
        type="text"
        name="username"
        id="username"
        value="<%= user.email %>"
        autocomplete="username"
        readonly
        aria-hidden="true"
        tabindex="-1"
        style="position: absolute; left: -9999px;"
      />
        <!-- Description pour les lecteurs d'écran -->
        <p id="form-description" class="sr-only">
          Formulaire pour mettre à jour votre mot de passe.
        </p>
    
        <!-- Mot de passe actuel -->
        <div class="form-row">
          <label for="current-password">Mot de passe actuel :</label>
          <input
            type="password"
            id="current-password"
            name="current-password"
            placeholder="Entrez votre mot de passe actuel"
            aria-required="true"
            autocomplete="current-password"

            required
          />
        </div>
    
     <!-- Nouveau mot de passe -->
<div class="form-row">
  <label for="new-password">Nouveau mot de passe :</label>
  <input
    type="password"
    id="new-password"
    name="new-password"
    placeholder="Entrez un nouveau mot de passe"
    aria-required="true"
    aria-describedby="password-requirements"
    minlength="12"
    autocomplete="new-password"
    required
  />
      </div>
    
        <!-- Confirmation du mot de passe -->
        <div class="form-row">
          <label for="confirm-password">Confirmation du mot de passe :</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            placeholder="Confirmez votre nouveau mot de passe"
            aria-required="true"
            autocomplete="new-password"
            required
          />
        </div>
    
        <!-- Message pour les lecteurs d'écran -->
        <p id="password-requirements" class="sr-only">
          Votre mot de passe doit contenir au moins 12 caractères.
        </p>
    
        <!-- Bouton de soumission -->
        <div class="form-button">
          <button type="submit" aria-label="Confirmer la mise à jour du mot de passe">
            Confirmer
          </button>
        </div>
      </form>
    </div>


  </section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const successMessage = document.getElementById("success-message");
    if (successMessage) {
      setTimeout(() => {
        successMessage.style.transition = "opacity 0.5s";
        successMessage.style.opacity = "0";
        setTimeout(() => {
          successMessage.remove();
        }, 500); // Temps pour l’animation
      }, 1500); // Durée d’affichage avant disparition
    }
  });
</script>
