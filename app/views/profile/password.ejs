
<%- include('../partials/header-profiles') %> <!-- Inclut le fichier header dans cette page -->
<main class="global-container">


  <aside class="dashboard-sidebar" role="navigation" aria-label="Menu principal"> <!-- Barre latérale pour la navigation principale -->
    <nav class="sidebar-menu"> <!-- Menu contenant des liens vers différentes sections -->
    <a href="/dashboard/overview" class="sidebar-link">Compte</a> <!-- Lien pour accéder à la page "Compte" -->
    <a href="/dashboard/income" class="sidebar-link">Analyse</a><!-- Lien pour accéder à la page "Analyse" -->
    <a href="/profile/settings" class="sidebar-link">Profil</a><!-- Lien pour accéder à la page "Profil" --> </nav>
    <a href="/" class="sidebar-link logout">Déconnexion</a> <!-- Lien pour se déconnecter, probablement lié à une session utilisateur --> </aside>



  <section class="hero">
    <h1>Modification du mot de passe</h1>
    


    <div class="form-container" role="form" aria-labelledby="form-description">
      <form action="/update-password" method="POST">
        <!-- Description pour les lecteurs d'écran -->
        <p id="form-description" class="sr-only">
          Formulaire pour mettre à jour votre mot de passe.
        </p>
    
        <!-- Mot de passe actuel -->
        <div class="form-row">
          <label for="current-password">Mot de passe actuel :</label>
          <input
            type="password"
            id="current-password"
            name="current-password"
            placeholder="Entrez votre mot de passe actuel"
            aria-required="true"
            required
          />
        </div>
    
        <!-- Nouveau mot de passe -->
        <div class="form-row">
          <label for="new-password">Nouveau mot de passe :</label>
          <input
            type="password"
            id="new-password"
            name="new-password"
            placeholder="Entrez un nouveau mot de passe"
            aria-required="true"
            aria-describedby="password-requirements"
            minlength="8"
            required
          />
        </div>
    
        <!-- Confirmation du mot de passe -->
        <div class="form-row">
          <label for="confirm-password">Confirmation du mot de passe :</label>
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            placeholder="Confirmez votre nouveau mot de passe"
            aria-required="true"
            required
          />
        </div>
    
        <!-- Message pour les lecteurs d'écran -->
        <p id="password-requirements" class="sr-only">
          Votre mot de passe doit contenir au moins 8 caractères.
        </p>
    
        <!-- Bouton de soumission -->
        <div class="form-button">
          <button type="submit" aria-label="Confirmer la mise à jour du mot de passe">
            Confirmer
          </button>
        </div>
      </form>
    </div>


  </section>
</main>

<%- include('../partials/footer') %> <!-- Inclut le fichier footer dans cette page -->